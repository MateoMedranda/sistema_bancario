    {
      "name": "3. Eventos Asíncronos (Redis -> UsuariosBDD)",
      "item": [
        {
          "name": "Publicar Evento Asíncrono de Creación de Usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"create\",\n  \"name\": \"nuevo_usuario_redis\",\n  \"email\": \"redis@banco.com\",\n  \"identityId\": \"0999888777\",\n  \"role\": \"CLIENTE\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/usuarios/evento",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "usuarios",
                "evento"
              ]
            },
            "description": "Publica un evento asíncrono en Redis (canal usuario.evento). El API Gateway responde inmediatamente sin bloquear al emisor y el microservicio svc-usuarios lo procesa en background persistiendo en UsuariosBDD."
          },
          "response": []
        }
      ]
    },

    {
      "name": "2. Transacciones y Cuentas (TCP + gRPC + RabbitMQ)",
      "item": [
        {
          "name": "Crear Depósito en Cuenta de Ahorros (+$100)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": \"a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11\",\n  \"type\": \"DEPOSITO\",\n  \"amount\": 100,\n  \"refCode\": \"REF001\",\n  \"description\": \"Depósito de prueba Tarea 3\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/transacciones",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "transacciones"
              ]
            },
            "description": "Envía comando síncrono por TCP desde el Gateway hacia svc-transacciones. Este se comunica por gRPC con svc-cuentas para actualizar el saldo y publica un evento en RabbitMQ."
          },
          "response": []
        },
        {
          "name": "Crear Transferencia entre Cuentas ($50)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountId\": \"a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11\",\n  \"destinationAccountId\": \"b0eebc99-9c0b-4ef8-bb6d-6bb9bd380b22\",\n  \"type\": \"TRANSFERENCIA\",\n  \"amount\": 50,\n  \"refCode\": \"REF002\",\n  \"description\": \"Transferencia de ahorros a corriente\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/transacciones",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "transacciones"
              ]
            },
            "description": "Ejecuta una transferencia descontando de la cuenta de ahorros (a0eebc99-...) y sumando a la cuenta corriente (b0eebc99-...)."
          },
          "response": []
        },
        {
          "name": "Crear Retiro de Cuenta de Ahorros (-$20)",
          "request": {
            "method": "POST",
            "header": [

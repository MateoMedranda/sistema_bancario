      "item": [
        {
          "name": "Login - Cliente (Guardar Token CLIENTE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.access_token) {",
                  "    pm.collectionVariables.set('jwt_token', jsonData.access_token);",
                  "    pm.globals.set('jwt_token', jsonData.access_token);",
                  "    try { pm.environment.set('jwt_token', jsonData.access_token); } catch(e) {}",
                  "    console.log('Token JWT guardado (rol CLIENTE):', jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"cliente\",\n  \"password\": \"cliente123\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [

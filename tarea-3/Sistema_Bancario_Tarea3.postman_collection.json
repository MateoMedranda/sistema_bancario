{
  "info": {
    "_postman_id": "c1a2b3c4-d5e6-7f8a-9b0c-1d2e3f4a5b6c",
    "name": "Sistema Bancario - Tarea 3 (JWT, Bcrypt & Microservicios)",
    "description": "Colección completa de endpoints del API Gateway (http://localhost:3000) para la Tarea 3 del Sistema Bancario Distribuido.\n\nContenido:\n- 1. Autenticación (Login con emisión de JWT y verificación de Bcrypt salado en UsuariosBDD)\n- 2. Transacciones (Comunicación TCP Gateway -> svc-transacciones -> gRPC svc-cuentas + Auditoría en RabbitMQ)\n- 3. Eventos Asíncronos (Comunicación Redis Gateway -> svc-usuarios sin bloqueo del emisor)\n- 4. Sistema (Health Check)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autenticación (JWT & Bcrypt en UsuariosBDD)",
      "item": [
        {
          "name": "Login - Cliente (emitir JWT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"cliente\",\n  \"password\": \"cliente123\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Valida credenciales del usuario 'cliente' contra la base de datos UsuariosBDD en PostgreSQL verificando el hash Bcrypt con sal ($2b$10$...) y retorna un JWT firmado."
          },
          "response": []
        },
        {
          "name": "Login - Admin (emitir JWT)",
          "request": {
